# --- Required ---
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Model (OpenRouter slug) ---
KIO_MODEL=anthropic/claude-haiku-4.5

# --- CORS: comma-separated allowed origins ---
ALLOWED_ORIGINS=https://kioprotocol.xyz,https://www.kioprotocol.xyz

# --- Free daily query cap per IP (Supabase-backed) ---
FREE_DAILY_LIMIT=15

# --- Supabase (optional; without it, no rate limit + no verdict log) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxxxxxxx

# --- Misc ---
IP_SALT=change-me-to-a-random-string
PORT=8080
LOG_LEVEL=info
